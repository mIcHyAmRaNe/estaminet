{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estaminet",
  "version": "0.5.3",
  "identifier": "com.starlab.estaminet",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Estaminet",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mIcHyAmRaNe/estaminet/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRkU0MjdDMTlBNjVEQjgKUldTNFhhWVpmRUwrTVg4TEdFVUpSY3d0RzM5UnpyM0Vwa1RXMVQxa0lLc2JLT283WW5GZHdWaU0K"
    }
  }
}
